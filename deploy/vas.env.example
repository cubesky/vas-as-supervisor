# ---- storage --------------------------------------------------------------
# Root of all managed data. Compose projects go to $VAS_DATA_DIR/container/<name>,
# LXC to $VAS_DATA_DIR/lxc/<name>, VMs to $VAS_DATA_DIR/vm/<name>.
VAS_DATA_DIR=/mnt/data
#VAS_COMPOSE_DIR=/mnt/data/container
#VAS_LXC_DIR=/mnt/data/lxc
#VAS_VM_DIR=/mnt/data/vm
#VAS_ISO_DIR=/mnt/data/iso
#VAS_SNAPSHOT_DIR=/mnt/data/.snapshots
#VAS_CONFIG_DIR=/mnt/data/vas/config
#VAS_STATE_DIR=/mnt/data/vas/state
#VAS_LOG_DIR=/mnt/data/vas/logs

# The filesystem is detected automatically: each compose / LXC / VM folder is a btrfs
# subvolume only when it lives on btrfs, and a plain folder on ext4, xfs, zfs, etc.
# Set to "off" to use plain folders even on btrfs.
#VAS_BTRFS=off

# ---- web ------------------------------------------------------------------
VAS_PORT=8080
VAS_HOST=0.0.0.0
VAS_LOG_LEVEL=info
# Direct listen addresses (the way in when OpenResty is broken). Comma list of
# host:port or bare addresses (VAS_PORT is used), e.g. loopback + LAN only:
#VAS_LISTEN=127.0.0.1:8080,192.168.1.10:8080
# OpenResty and acme.sh call the manager on 127.0.0.1 — keep a loopback or
# 0.0.0.0 entry, or point them elsewhere with VAS_MANAGER_URL.
#VAS_MANAGER_URL=http://127.0.0.1:8080

# ---- VAS UI on a domain via OpenResty -------------------------------------
# Generates a read-only proxy route for the manager itself.
#VAS_PUBLIC_DOMAIN=manager.example.com
#VAS_PUBLIC_TLS=redirect          # off | on | redirect
#VAS_PUBLIC_CERT=auto             # auto (match by domain) or a certificate id
#VAS_PUBLIC_HSTS=false
#VAS_PUBLIC_ALLOW=10.0.0.0/8,192.168.0.0/16   # optional IP allow-list
# WAF on the VAS UI route: off | detect | block (off by default: the UI
# legitimately submits code such as Lua, compose files and shell snippets)
#VAS_PUBLIC_WAF=off
# Automatic Let's Encrypt certificate for that domain (acme.sh DNS-01):
#VAS_ACME_EMAIL=admin@example.com
#VAS_PUBLIC_DNS_PROVIDER=dns_cf
#VAS_PUBLIC_DNS_ENV=CF_Token,CF_Zone_ID   # names of the variables below
#CF_Token=...
#CF_Zone_ID=...
#VAS_PUBLIC_DNS_ALIAS=acme-alias.example.net   # DNS alias mode (optional)
#VAS_PUBLIC_ACME_SERVER=letsencrypt

# ---- login (passkey only) ---------------------------------------------------
VAS_AUTH_ENABLED=true
# Leave VAS_RP_ID unset: passkeys are then bound to whatever hostname you
# open (the domain, or localhost through an SSH tunnel). If you can't log in,
# run `vas auth login-link` on the host for a one-time link.
#VAS_RP_ID=manager.example.com
#VAS_ORIGIN=https://manager.example.com
# Token required to register the first passkey (random one is logged if unset)
#VAS_SETUP_TOKEN=change-me
#VAS_SESSION_TTL_HOURS=168

# ---- OpenResty agent / acme.sh hook ----------------------------------------
# Shared by the manager, the OpenResty agent and the acme.sh reload hook.
# Generate with: openssl rand -base64 32
VAS_AGENT_TOKEN=
VAS_OPENRESTY_CONTAINER=vas-openresty

# ---- acme.sh ------------------------------------------------------------------
VAS_ACME_MODE=podman
VAS_ACME_CONTAINER=vas-acme
#VAS_ACME_HOME=/mnt/data/vas/acme
#VAS_ACME_CALLBACK_URL=http://127.0.0.1:8080

# ---- crash management --------------------------------------------------------
# auto: enter safe mode (no autostart / watchdog) after N unclean starts in the window
VAS_SAFE_MODE=auto
VAS_CRASH_LOOP_THRESHOLD=3
VAS_CRASH_LOOP_WINDOW_SEC=900

# ---- integrations ------------------------------------------------------------
#VAS_LIBVIRT_URI=qemu:///system
# Where lxc-* runs: auto (host via nsenter when in a container with pid: host), host, local
#VAS_LXC_EXEC=auto
# Image server for LXC's download template (hostname of a mirror, if you use one)
#VAS_LXC_IMAGE_SERVER=images.linuxcontainers.org
# Extra container names the UI must treat as read-only (VAS's own are automatic)
#VAS_SYSTEM_CONTAINERS=
# CLI admin socket (root-only)
#VAS_ADMIN_SOCKET=/mnt/data/vas/state/admin.sock
#VAS_PODMAN_BIN=podman
#VAS_PODMAN_COMPOSE_BIN=podman-compose

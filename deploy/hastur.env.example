# ---- storage --------------------------------------------------------------
# Root of all managed data. Compose projects go to $HASTUR_DATA_DIR/container/<name>,
# LXC to $HASTUR_DATA_DIR/lxc/<name>, VMs to $HASTUR_DATA_DIR/vm/<name>.
HASTUR_DATA_DIR=/mnt/data
#HASTUR_COMPOSE_DIR=/mnt/data/container
#HASTUR_LXC_DIR=/mnt/data/lxc
#HASTUR_VM_DIR=/mnt/data/vm
#HASTUR_ISO_DIR=/mnt/data/iso
#HASTUR_SNAPSHOT_DIR=/mnt/data/.snapshots
#HASTUR_CONFIG_DIR=/mnt/data/hastur/config
#HASTUR_STATE_DIR=/mnt/data/hastur/state
#HASTUR_LOG_DIR=/mnt/data/hastur/logs

# The filesystem is detected automatically: each compose / LXC / VM folder is a btrfs
# subvolume only when it lives on btrfs, and a plain folder on ext4, xfs, zfs, etc.
# Set to "off" to use plain folders even on btrfs.
#HASTUR_BTRFS=off

# ---- web ------------------------------------------------------------------
HASTUR_PORT=8080
HASTUR_HOST=0.0.0.0
HASTUR_LOG_LEVEL=info

# ---- login (passkey only) ---------------------------------------------------
HASTUR_AUTH_ENABLED=true
# Relying party: must equal the hostname you open the UI with
#HASTUR_RP_ID=manager.example.com
#HASTUR_ORIGIN=https://manager.example.com
# Token required to register the first passkey (random one is logged if unset)
#HASTUR_SETUP_TOKEN=change-me
#HASTUR_SESSION_TTL_HOURS=168

# ---- OpenResty agent / acme.sh hook ----------------------------------------
# Shared by the manager, the OpenResty agent and the acme.sh reload hook.
# Generate with: openssl rand -base64 32
HASTUR_AGENT_TOKEN=
HASTUR_OPENRESTY_CONTAINER=hastur-openresty

# ---- acme.sh ------------------------------------------------------------------
HASTUR_ACME_MODE=podman
HASTUR_ACME_CONTAINER=hastur-acme
#HASTUR_ACME_HOME=/mnt/data/hastur/acme
#HASTUR_ACME_CALLBACK_URL=http://127.0.0.1:8080

# ---- crash management --------------------------------------------------------
# auto: enter safe mode (no autostart / watchdog) after N unclean starts in the window
HASTUR_SAFE_MODE=auto
HASTUR_CRASH_LOOP_THRESHOLD=3
HASTUR_CRASH_LOOP_WINDOW_SEC=900

# ---- integrations ------------------------------------------------------------
#HASTUR_LIBVIRT_URI=qemu:///system
# Where lxc-* runs: auto (host via nsenter when in a container with pid: host), host, local
#HASTUR_LXC_EXEC=auto
# Image server for LXC's download template (hostname of a mirror, if you use one)
#HASTUR_LXC_IMAGE_SERVER=images.linuxcontainers.org
#HASTUR_PODMAN_BIN=podman
#HASTUR_PODMAN_COMPOSE_BIN=podman-compose
